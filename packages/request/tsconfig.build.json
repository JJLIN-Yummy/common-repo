{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    // ✅ 只保留node，手动剔除继承来的 vitest/globals
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__",
    "**/*.test.ts",
    "vitest.config.ts",
    "tsup.config.ts"
  ]
}
