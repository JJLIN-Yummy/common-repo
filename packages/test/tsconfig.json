{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "typeRoots": ["./node_modules/@types/", "./types"],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "*.config.ts",
    "types/**/*.d.ts", // types目录下所有类型声明文件
    "types/**/*.ts" // types目录下所有TS文件,
  ],
  "exclude": ["node_modules", "dist"]
}
